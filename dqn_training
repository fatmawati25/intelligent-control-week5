import numpy as np

# Patch untuk kompatibilitas Gymnasium/Gym lama dengan NumPy baru
if not hasattr(np, "bool8"):
    np.bool8 = np.bool_

import gymnasium as gym
import tensorflow as tf
from tensorflow import keras
from collections import deque
import random

# --- 1. Inisialisasi Lingkungan dan Parameter DRL ---

env = gym.make("CartPole-v1")
state_size = env.observation_space.shape[0]
action_size = env.action_space.n

learning_rate = 0.001
gamma = 0.95
epsilon = 1.0
epsilon_min = 0.01
epsilon_decay = 0.995
batch_size = 32
memory = deque(maxlen=2000)

# --- 2. Membangun Model Deep Q-Network (DQN) ---

def build_dqn_model():
    model = keras.Sequential([
        keras.layers.Dense(24, input_shape=(state_size,), activation="relu"),
        keras.layers.Dense(24, activation="relu"),
        keras.layers.Dense(action_size, activation="linear")
    ])
    model.compile(loss="mse", optimizer=keras.optimizers.Adam(learning_rate=learning_rate))
    return model

model = build_dqn_model()
print("Model DQN berhasil dibuat.")
model.summary()
print("-" * 50)

# --- 3. Fungsi Pemilihan Aksi (Epsilon-Greedy) ---

def select_action(state, epsilon_val):
    if np.random.rand() <= epsilon_val:
        return np.random.choice(action_size)
    q_values = model.predict(state, verbose=0)
    return np.argmax(q_values[0])

# --- 4. Fungsi Pelatihan Model (Experience Replay) ---

def train_model(minibatch, current_model, gamma_val):
    for state, action, reward, next_state, done in minibatch:
        target = reward
        if not done:
            future_q = np.amax(current_model.predict(next_state, verbose=0)[0])
            target += gamma_val * future_q
        target_f = current_model.predict(state, verbose=0)
        target_f[0][action] = target
        current_model.fit(state, target_f, epochs=1, verbose=0)

# --- 5. Proses Training Utama ---

print("Memulai proses training...")
MAX_EPISODES = 1000
episode_scores = []

for episode in range(MAX_EPISODES):
    state, _ = env.reset()
    state = np.reshape(state, [1, state_size])
    score = 0

    for time in range(500):
        action = select_action(state, epsilon)
        next_state, reward, terminated, truncated, _ = env.step(action)
        done = terminated or truncated
        next_state = np.reshape(next_state, [1, state_size])
        memory.append((state, action, reward, next_state, done))
        state = next_state
        score += reward
        if done:
            break

    episode_scores.append(time + 1)

    if len(memory) > batch_size:
        minibatch = random.sample(memory, batch_size)
        train_model(minibatch, model, gamma)

    epsilon = max(epsilon_min, epsilon * epsilon_decay)

    print(f"Episode: {episode + 1}/{MAX_EPISODES}, Score: {time + 1}, Epsilon: {epsilon:.4f}")

    if episode >= 10:
        recent_scores = episode_scores[-10:]
        if np.mean(recent_scores) >= 195:
            print("\n!!! Selesai Lebih Cepat: Agen dianggap berhasil menguasai CartPole !!!")
            break

print("-" * 50)
print("Training selesai!")
